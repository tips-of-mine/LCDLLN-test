{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "LCDLLN — Master et Shard",
  "uid": "lcdlln-servers",
  "tags": [
    "lcdlln",
    "mmorpg"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "shard_job",
        "label": "Job shard",
        "type": "custom",
        "query": "lcdlln-shard",
        "current": {
          "text": "lcdlln-shard",
          "value": "lcdlln-shard"
        },
        "options": [
          {
            "text": "lcdlln-shard",
            "value": "lcdlln-shard",
            "selected": true
          }
        ],
        "hide": 0
      },
      {
        "name": "master_job",
        "label": "Job master",
        "type": "custom",
        "query": "lcdlln-master",
        "current": {
          "text": "lcdlln-master",
          "value": "lcdlln-master"
        },
        "options": [
          {
            "text": "lcdlln-master",
            "value": "lcdlln-master",
            "selected": true
          }
        ],
        "hide": 0
      }
    ]
  },
