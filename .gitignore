smtp.local.json
.claude/
.gitea/
.clone/
.vscode/
.superpowers/
world_editor_imgui.ini
world_editor.log

# SPIR-V généré (sources GLSL dans game/data/shaders/) — voir tools/compile_game_shaders.ps1
game/data/shaders/*.spv

# Répertoires de build CMake locaux (build/linux-x64*, build/win-x64*, etc.).
build/
# M100.9 : PNG placeholders 4x4 generes par tools/gen_terrain_placeholders au build.
game/data/terrain/placeholders/*.png
# M100.45 : prefs editeur locales par utilisateur (creees au premier lancement).
game/data/editor/user_prefs.json
game/data/editor/user_prefs.json.tmp

# Asset pipeline binaries (downloaded by download_fbx2gltf.ps1)
tools/asset_pipeline/bin/*
!tools/asset_pipeline/bin/.gitignore

# Sauvegarde de reference du heightmap (raise_hill.py) — non versionnee
*.r16h.bak

# Fichiers de travail conversion props (throwaway)
_convert_log.txt
tools/asset_pipeline/_validate_out/

# Monde « Royaumes » (cellules de 10 km) : sorties GÉNÉRÉES par tools/world_gen
# (lcdlln_world_gen ; la CI les produira avant l'empaquetage à l'étape 4) — jamais versionnées.
# Seule la source (world/royaumes/world_master.json) et la bibliothèque de maisons
# (buildings/templates/maison.json) sont dans git. Cf. docs/world/ROYAUMES.md.
game/data/zones/cell_*/
!game/data/zones/cell_n000_e000/
game/data/instances/zone_cell_*/
game/data/world/royaumes/*
!game/data/world/royaumes/world_master.json
