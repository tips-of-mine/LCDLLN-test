          "expr": "(lcdlln_shard_mobs{job=\"$shard_job\"} - lcdlln_shard_mobs_asleep{job=\"$shard_job\"}) / clamp_min(lcdlln_shard_clients{job=\"$shard_job\"}, 1)",
